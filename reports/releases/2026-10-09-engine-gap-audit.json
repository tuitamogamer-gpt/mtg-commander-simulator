  "scope": "Bounded native cast routes, special timing, off-zone X payment, effective creature types, dispatch and combat transitions, plus mobile controls.",
  "findings": [
    {
      "id": "effect-free-casting",
      "problem": "Effect-driven free casting omitted exact temporary face permission for MDFCs and forced the creature half of Adventures.",
      "result": "Existing immediate casting permission now offers the legal face or Adventure with normal target and choice processing.",
      "examples": [
        "Etali, Primal Storm",
        "Boggart Trawler // Boggart Bog",
        "Sea Gate Restoration // Sea Gate, Reborn"
      ]
    },
    {
      "id": "card-copy-casting",
      "problem": "Legacy copied cards used an unsupported copyspace and printed optional copy casts were forced.",
      "result": "Temporary native copies enter exile with exact casting permission; unused copies are cleaned up. Optional and mandatory callers keep their printed choice.",
      "examples": [
        "Mizzix's Mastery",
        "Psionic Ritual",
        "Bloodthirsty Adversary",
        "Spelltwine"
      ]
    },
    {
      "id": "temporary-definition-restoration",
      "problem": "Oracle v89 restored a printed definition even when no temporary Harmonize wrapper had been installed, overwriting resolved face-down, Prototype or copied characteristics.",
      "result": "Only the exact installed temporary wrapper is restored, including matching stored face-down definitions.",
      "examples": [
        "Willbender",
        "Branch of Vitu-Ghazi",
        "Sculpting Steel",
        "Harmonize and Prototype native controls"
      ]
    },
    {
      "id": "loyalty-timing",
      "problem": "The final priority filter removed legal instant-speed loyalty activations.",
      "result": "Teferi and entry-turn Emperor grants survive that filter; ordinary loyalty, once-per-turn limits and activation taxes remain enforced.",
      "examples": [
        "Teferi, Master of Time",
        "The Wandering Emperor",
        "Jace Beleren with earned Teferi emblem"
      ]
    },
    {
      "id": "abolisher-zone-scope",
      "problem": "Grand Abolisher treated creature cards in hand as battlefield creature permanents.",
      "result": "Its ability prohibition is scoped to battlefield permanents; legal hand Cycling and granted special actions remain usable.",
      "examples": [
        "Grand Abolisher",
        "Drannith Healer",
        "Krosan Tusker",
        "Cosmos Charger"
      ]
    },
    {
      "id": "off-zone-x-cost-context",
      "problem": "X affordability and actual off-zone payment lost ability/X context, overcounting creature-spell-only mana or rejecting Elementalist’s Palette mana for actual X abilities.",
      "result": "Hand Channel, Cycling and graveyard payments retain ability metadata and the printed X-cost marker.",
      "examples": [
        "Arashi, the Sky Asunder",
        "Jiwari, the Earth Aflame",
        "Webstrike Elite",
        "Shark Typhoon",
        "Rot-Curse Rakshasa",
        "Elementalist's Palette"
      ]
    },
    {
      "id": "outside-zone-type-layers",
      "problem": "Maskwood Nexus omitted outside-zone creature types; separate Adaptation wrappers ignored Conspiracy timestamps; proposed casts retained replaced Changeling or graveyard-only types. Foreign-owned paid-cast cost preview also omitted the proposed caster’s type effects.",
      "result": "One timestamp-ordered layer computes outside-card and proposed-spell subtypes and respects the applicable owner/controller and zone. A private, scoped proposed-caster context now applies only during synchronous spell-cost computation; card ownership, permanent control and casting permission remain separate.",
      "examples": [
        "Maskwood Nexus",
        "Arcane Adaptation",
        "Conspiracy",
        "Ashes of the Fallen",
        "Horde of Notions",
        "Ancient Cellarspawn",
        "Gonti, Lord of Luxury",
        "Herald's Horn"
      ]
    },
    {
      "id": "tribal-consumers",
      "problem": "Tribal cost and trigger consumers read printed subtype arrays instead of effective spell/card types.",
      "result": "Herald’s Horn, Door of Destinies, Director Nick Fury and Folk Hero recognize actual Changeling and type changes, including negative tribe replacement controls.",
      "examples": [
        "Herald's Horn",
        "Door of Destinies",
        "Director Nick Fury",
        "Folk Hero"
      ]
    },
    {
      "id": "artifact-ability-target-route",
      "problem": "Ayesha Tanaka compiled activated-ability targets through the permanent target route and was never offered.",
      "result": "The native stack-ability filter accepts artifact activations with source LKI while excluding creature abilities and artifact triggers.",
      "examples": [
        "Ayesha Tanaka",
        "Icy Manipulator",
        "Dispeller's Capsule"
      ]
    },
    {
      "id": "combat-incarnation-links",
      "problem": "Departure, blink, control change or losing creature type left stale reciprocal combat membership.",
      "result": "Combat removal preserves departure snapshots, removes stale links, retains unaffected multi-block assignments and does not unblock a formerly blocked attacker.",
      "examples": [
        "Cloudshift",
        "Act of Treason",
        "Thassa, God of the Sea",
        "Palace Guard",
        "Aurelia, the Warleader"
      ]
    },
    {
      "id": "first-strike-participation",
      "problem": "A first striker assigning zero first-step damage could gain a second ordinary damage step after a pump.",
      "result": "First-step eligibility is recorded before damage assignment, including zero or negative power; current double strike still permits normal damage.",
      "examples": [
        "Youthful Knight",
        "Fencing Ace",
        "Giant Growth"
      ]
    }
  ],
