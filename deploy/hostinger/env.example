# Copy to .env in this directory and fill in. Never commit the copy.
#   cp env.example .env && chmod 600 .env

# The hostname players' browsers connect to. Create a DNS A record for it that
# points at this VPS before the first start, or no certificate can be issued.
LIVE_DOMAIN=live.mtgpod.xyz

# The origins of the game's page, comma separated, exactly as the browser
# shows them (scheme and host, no path). Pages on any other site are refused.
LIVE_ALLOWED_ORIGINS=https://www.mtgpod.xyz,https://mtgpod.xyz

# Open connections the server accepts at once (one per player in a room).
LIVE_MAX_CONNECTIONS=400

# Memory Redis may use for rooms. A busy room can hold a few megabytes.
REDIS_MAXMEMORY=512mb

# Only if ports 80/443 on the VPS belong to something else. A certificate can
# only be issued automatically on the standard ports.
# LIVE_HTTP_PORT=80
# LIVE_HTTPS_PORT=443

# Optional: room storage somewhere else instead of the bundled Redis.
# REDIS_URL=
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
