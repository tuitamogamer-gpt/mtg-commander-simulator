{
  "name": "mtg-commander-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "certify": "node scripts/certify-cards.mjs",
    "certify:strict": "node scripts/certify-cards.mjs --strict",
    "check": "node scripts/check-syntax.mjs",
    "catalog:export": "node scripts/export-card-catalog.mjs",
    "import:oracle-batch": "node scripts/import-oracle-batch.mjs",
    "sync:card-images": "node scripts/sync-card-images.mjs",
    "test:ai": "node --test tests/ai-v2.test.mjs tests/headless-smoke.test.mjs",
    "test:ai:unit": "node --test tests/ai-v2.test.mjs",
    "test:ai:games": "node --test tests/headless-smoke.test.mjs",
    "test:focused": "node --test --test-concurrency=2 tests/baseline.test.mjs tests/ui-decision-render-recovery.test.mjs tests/creature-type-choice-ui.test.mjs tests/ai-pending-source-isolation.test.mjs tests/ai-priority-simulation-outcomes.test.mjs tests/account-request-input.test.mjs tests/account-api.test.mjs tests/account-client.test.mjs tests/save-continue.test.mjs tests/combat-transition-audit.test.mjs tests/ninjutsu-copied-attacker.test.mjs tests/yuriko-ninjutsu-window.test.mjs tests/stack-relational-ninjutsu.test.mjs tests/ninjutsu-throne-entry-preview.test.mjs tests/ninjutsu-thousand-faced-shadow.test.mjs tests/target-zone-and-suspend-regressions.test.mjs tests/timing-suspend-evoke-regressions.test.mjs",
    "benchmark:ai": "node scripts/benchmark-ai.mjs",
    "package:public": "node scripts/package-public.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test:server": "node --test tests/vercel-multiplayer-server.test.mjs tests/vercel-action-replay.test.mjs tests/redis-room-lease.test.mjs tests/multiplayer-reconnect.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mechanics": "node --test tests/*.test.mjs",
    "test:baseline": "node --test tests/baseline.test.mjs",
    "ios:bundle": "node scripts/build-ios-web.mjs",
    "ios:sync": "npm run ios:bundle && cap sync ios",
    "ios:open": "cap open ios",
    "ios:test": "node --test tests/ios-package.test.mjs",
    "ios:package": "npm run ios:sync && node scripts/package-ios-mac.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
